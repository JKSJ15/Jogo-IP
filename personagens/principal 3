import pygame
import sys

# --- CLASSE DA PERSONAGEM (MENINA NEGRA) ---
class PersonagemMeninaNegra(pygame.sprite.Sprite):
    # Paleta de cores 16-bit estilo Pokémon FireRed
    PALETTE = {
        ".": None,              # Transparente
        "K": (24, 24, 24),      # Contorno escuro
        "H": (44, 30, 26),      # Cabelo crespo escuro
        "D": (68, 46, 40),      # Luz/textura do cabelo
        "S": (140, 88, 56),     # Pele negra
        "B": (104, 62, 38),     # Sombra da pele
        "T": (42, 42, 48),      # Camiseta preta
        "R": (224, 48, 48),     # Símbolo vermelho / Elástico / Tênis
        "M": (112, 72, 48),     # Alças da mochila
        "P": (32, 32, 38),      # Saia escura
        "W": (248, 248, 248),   # Detalhe branco do tênis
    }

    # Desenho pixel a pixel (16x24): cabelo crespo preso em dois puffs, camiseta preta com símbolo vermelho e saia
    SPRITE_DATA = [
        ".KKK........KKK.",
        "KHHHK.KKKK.KHHHK",
        "KHDHHKHHHHKHHDHK",
        ".KKKHHHHHHHHKKK.",
        "..KHDDDDDDDDHK..",
        "..KHSSSSSSSSHK..",
        "..KSSKSSSSKSSK..",
        "..KSSKSSSSKSSK..",
        "...KBBBBBBBBK...",
        "....KKKKKKKK....",
        "..KKTTTTTTTTKK..",
        ".KTTMTTTRRTTTMK.",
        ".KSSTTTTRRTTSSK.",
        ".KSSTTTTTTTTSSK.",
        "..KKPPPPPPPPKK..",
        "..KPPPPPPPPPPK..",
        "..KKKKKKKKKKKK..",
        "...KSSSK.KSSSK..",
        "...KSSSK.KSSSK..",
        "...KBBBK.KBBBK..",
        "...KRRRK.KRRRK..",
        "..KWWRRK.KRRWWK.",
        "..KKKKKK.KKKKKK.",
        "................",
    ]

    def __init__(self, x, y, scale=4, speed=3):
        super().__init__()
        self.w, self.h = 16, 24
        self.scale = scale
        self.speed = speed

        # Constrói a superfície original 16x24
        surf = pygame.Surface((self.w, self.h), pygame.SRCALPHA)
        for row_idx, row in enumerate(self.SPRITE_DATA):
            for col_idx, char in enumerate(row):
                color = self.PALETTE.get(char)
                if color:
                    surf.set_at((col_idx, row_idx), color)

        # Amplia sem borrar os pixels
        self.image_right = pygame.transform.scale(surf, (self.w * scale, self.h * scale))
        self.image_left = pygame.transform.flip(self.image_right, True, False)
        self.image = self.image_right
        self.rect = self.image.get_rect(center=(x, y))

    def update(self, keys, screen_w, screen_h):
        if keys[pygame.K_LEFT] or keys[pygame.K_a]:
            self.rect.x -= self.speed
            self.image = self.image_left
        if keys[pygame.K_RIGHT] or keys[pygame.K_d]:
            self.rect.x += self.speed
            self.image = self.image_right
        if keys[pygame.K_UP] or keys[pygame.K_w]:
            self.rect.y -= self.speed
        if keys[pygame.K_DOWN] or keys[pygame.K_s]:
            self.rect.y += self.speed

        # Impede a personagem de sair da tela
        self.rect.clamp_ip(pygame.Rect(0, 0, screen_w, screen_h))


# --- INICIALIZAÇÃO E LOOP DO JOGO ---
def main():
    pygame.init()
    SCREEN_W, SCREEN_H = 480, 320
    screen = pygame.display.set_mode((SCREEN_W, SCREEN_H))
    pygame.display.set_caption("Personagem Menina Negra 16-bit - Estilo FireRed")
    clock = pygame.time.Clock()

    # Cria a personagem no centro da tela
    jogadora = PersonagemMeninaNegra(x=SCREEN_W // 2, y=SCREEN_H // 2, scale=4, speed=3)
    todos_sprites = pygame.sprite.Group(jogadora)

    while True:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()

        keys = pygame.key.get_pressed()
        todos_sprites.update(keys, SCREEN_W, SCREEN_H)

        # Fundo verde estilo grama de Kanto
        screen.fill((120, 200, 104))
        todos_sprites.draw(screen)

        pygame.display.flip()
        clock.tick(60)


if __name__ == "__main__":
    main()