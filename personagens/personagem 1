import pygame
import sys

pygame.init()

# Configurações de escala e janela
SCALE = 6
SPRITE_W, SPRITE_H = 16, 24
SCREEN_W, SCREEN_H = 320, 320
screen = pygame.display.set_mode((SCREEN_W, SCREEN_H))
pygame.display.set_caption("Personagem 16-bit")
clock = pygame.time.Clock()

# Paleta 16-bit estilo FireRed
PALETTE = {
    ".": None,              # Transparente
    "K": (24, 24, 24),      # Contorno escuro
    "H": (88, 56, 36),      # Cabelo castanho
    "D": (56, 36, 24),      # Sombra do cabelo
    "S": (248, 200, 152),   # Pele
    "T": (42, 42, 48),      # Camiseta preta
    "R": (224, 48, 48),     # Símbolo vermelho / Tênis
    "M": (112, 72, 48),     # Alças da mochila
    "P": (32, 32, 38),      # Bermuda preta
    "W": (248, 248, 248),   # Detalhe branco do tênis
}

# Matriz 16x24 do personagem (cabelo bagunçado sem boné, camiseta preta com símbolo vermelho)
CHARACTER_SPRITE = [
    "....KK..KK......",
    "...KHHKKHHKK....",
    "..KHHHHHHHHHK...",
    ".KHHDDDDDDHHHK..",
    ".KHDHHHHHHHDHK..",
    "..KHSSSSSSSHK...",
    "..KSSKSSKSSSK...",
    "..KSSKSSKSSSK...",
    "...KSSSSSSSK....",
    "....KKKKKKK.....",
    "..KKTTTTTTTKK...",
    ".KTTMTTTRRTTMK..",
    ".KSSTTTTRRTTSSK.",
    ".KSSTTTTTTTTSSK.",
    ".KKKTTTTTTTKKK..",
    "...KPPPPPPPK....",
    "...KPPPPPPPK....",
    "...KPPPKPPPK....",
    "...KSSSKSSSK....",
    "...KSSSKSSSK....",
    "...KRRRKRRRK....",
    "..KWWRRKRRWWK...",
    "..KKKKKKKKKKK...",
    "................",
]

def criar_personagem(scale=SCALE):
    surface = pygame.Surface((SPRITE_W, SPRITE_H), pygame.SRCALPHA)
    for y, row in enumerate(CHARACTER_SPRITE):
        for x, char in enumerate(row):
            color = PALETTE.get(char)
            if color:
                surface.set_at((x, y), color)
    return pygame.transform.scale(surface, (SPRITE_W * scale, SPRITE_H * scale))

personagem = criar_personagem()
rect = personagem.get_rect(center=(SCREEN_W // 2, SCREEN_H // 2))

while True:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()
            sys.exit()

    screen.fill((255, 255, 255))
    screen.blit(personagem, rect)
    pygame.display.flip()
    clock.tick(60)